{
  "name": "server",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && npm run copy:migrations",
    "copy:migrations": "mkdir -p dist/migrations && cp -R src/migrations/*.sql dist/migrations/",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "ae-cvss-calculator": "^1.0.13",
    "better-sqlite3": "^11.0.0",
    "hono": "^4.12.29"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
